#| label: fig-resid
#| fig-cap: "Residuals for linear mixed models."
#| fig-width: 5
#| fig-height: 4
library(patchwork)
trial_points <- seq(1, ncol(cflmm2$residuals), length.out = 6) %>%
floor()
cflmm2 <- fastFMM::fui(
photometry ~ outcome * reward + session + trial + (outcome | id),
dat,
concurrent = T,
residuals = T,
silent = T)
#| label: fig-resid
#| fig-cap: "Residuals for linear mixed models."
#| fig-width: 5
#| fig-height: 4
library(patchwork)
trial_points <- seq(1, ncol(cflmm2$residuals), length.out = 6) %>%
floor()
cflmm2_resids <- lapply(trial_points,
function(s) data.frame(s = s, resid = cflmm2$residuals[, s])) %>%
do.call(rbind, .) %>%
mutate(model = "cFLMM", s = factor(s))
p1_cflmm <- ggplot(cflmm2_resids, aes(sample = resid)) +
stat_qq(shape = 20, color = cflmm_color, alpha = 0.8) +
stat_qq_line() +
labs(x = NULL, y = NULL) +
theme(axis.text = element_blank(), panel.grid = element_blank())
p2_cflmm <- ggplot(cflmm2_resids, aes(sample = resid)) +
facet_wrap(vars(s), nrow = 2) +
stat_qq(shape = 20, color = cflmm_color, alpha = 0.8) +
stat_qq_line() +
labs(x = NULL, y = NULL) +
theme(
axis.text = element_blank(),
panel.grid = element_blank(),
strip.text.x = element_blank())
trial_points <- seq(1, ncol(ncflmm2$residuals), length.out = 6) %>%
floor()
ncflmm2_resids <- lapply(trial_points,
function(s) data.frame(s = s, resid = ncflmm2$residuals[, s])) %>%
do.call(rbind, .) %>%
mutate(model = "ncFLMM", s = factor(s))
p1_ncflmm <- ggplot(ncflmm2_resids, aes(sample = resid)) +
stat_qq(shape = 20, color = ncflmm_color, alpha = 0.8) +
stat_qq_line() +
labs(x = NULL, y = NULL) +
theme(axis.text = element_blank(), panel.grid = element_blank())
p2_ncflmm <- ggplot(ncflmm2_resids, aes(sample = resid)) +
facet_wrap(vars(s), nrow = 2) +
stat_qq(shape = 20, color = ncflmm_color, alpha = 0.8) +
stat_qq_line() +
labs(x = NULL, y = NULL) +
theme(
axis.text = element_blank(),
panel.grid = element_blank(),
strip.text.x = element_blank())
(p1_cflmm | p2_cflmm) / (p1_ncflmm | p2_ncflmm) + plot_layout(widths = c(1, 2.5))
ggsave(here(img_dir, "resid.png"), width = 5, height = 4, dpi = 600)
ggplot(cflmm2_resids, aes(sample = resid)) +
facet_wrap(vars(s), nrow = 2) +
stat_qq(shape = 20, color = cflmm_color, alpha = 0.8) +
stat_qq_line() +
labs(x = NULL, y = NULL)
p_cflmm
