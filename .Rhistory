fit_lm <- function(mua, X) {
n_sites <- dim(mua)[2]
r_sq <- data.frame(
site = 1:n_sites,
r_sq = rep(NA, n_sites))
res <- lapply(cli_progress_along(1:n_sites), function(i) {
dat <- mutate(X, y = mua[, i])
fit <- lm(y ~ ., dat)
df <- summary(fit)$coefficients %>%
data.frame() %>%
tibble::rownames_to_column()
colnames(df) <- c("x", "beta_hat", "se", "t_val", "p_val")
r_sq[i, 2] <- summary(fit)$r.squared
list(coefs = df %>% mutate(site = i), resids = residuals(fit)) })
list(
coefs = lapply(res, function(x) x[["coefs"]]) %>% do.call(rbind, .),
resids = lapply(res, function(x) x[["resids"]]) %>% do.call(rbind, .))
}
lm_fits <- lapply(regions, function(region) {
cli_text(region)
mua <- qs_read(here(out_dir, "avgs.qs2")) %>% .[[region]]
fit_lm(mua, X) })
