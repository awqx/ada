balanced_splits <- function(n_reps) {
combos <- combn(n_reps, n_reps / 2)
n_splits <- ncol(combos) / 2
grps_1 <- combos[, 1:n_splits, drop = FALSE]
grps_2 <- apply(grps_1, 2, function(x) setdiff(seq_len(n_reps), x))
list(grps_1, grps_2)
}
balanced_splits(6)
#' Generate split pair indices
#'
#' Applies when the number of repetitions is even.
#'
#' @param n_reps number of repetitions (even).
balanced_splits <- function(n_reps) {
combos <- combn(n_reps, n_reps / 2)
n_splits <- ncol(combos) / 2
grps_1 <- combos[, 1:n_splits, drop = FALSE]
grps_2 <- apply(grps_1, 2, function(x) seq_len(n_reps)[-x])
list(grps_1, grps_2)
}
balanced_splits(6)
