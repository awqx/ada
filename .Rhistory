nb_id <- "5-revisions-d2pvt"
here::i_am(paste0(nb_id, ".qmd"))
library(here)
library(dplyr)
library(stringr)
library(tidyr)
library(ggplot2)
library(gt)
library(patchwork)
library(fastFMM)
img_dir <- here("img", nb_id)
res_dir <- here("data")
if (!dir.exists(img_dir)) dir.create(img_dir)
if (!dir.exists(res_dir)) dir.create(res_dir)
strawberry <- "#DF536B"
water <- "#56B4E9"
# ggplot2 settings
theme_set(theme_minimal())
theme_set(theme_minimal(base_size = 9))
knitr::opts_chunk$set(warning = F, message = F, cache = T)
#| label: fig-latency
#| fig-cap: "Overlaid histograms for the reward latencies for water (blue) and strawberry milkshake (orange). The dashed lines indicate the respective means."
#| fig-width: 2.5
#| fig-height: 3.5
latency_1 <- hsms_hh2o %>%
group_by(reward) %>%
summarize(mean_latency = mean(latency)) %>%
mutate(session = "Overall")
hsms_hh2o <- read.csv("data-raw/3-d2pvt/D2PVT_FLMM_input_HSMSvsHH2O.csv") %>%
select(-Trial_no) %>%
rename(
id = Animal.ID,
session = Session.no,
reward = Outcome,
trial = Trial_order,
latency = Approach_Latency) %>%
mutate(
id = str_remove_all(id, "^[[:digit:]]{8}\\_D2PVT|\\_L[[:digit:]]+$"),
reward = case_when(
reward == "H-SMS" ~ "Shake", reward == "H-H2O" ~ "Water"),
session = str_replace(session, "^S", "Session ")) %>%
mutate(id = paste0("ID ", sprintf("%02d", as.integer(id)))) %>%
mutate(
id = factor(id),
reward = factor(reward, levels = c("Water", "Shake")),
session = factor(session))
#| label: fig-latency
#| fig-cap: "Overlaid histograms for the reward latencies for water (blue) and strawberry milkshake (orange). The dashed lines indicate the respective means."
#| fig-width: 2.5
#| fig-height: 3.5
latency_1 <- hsms_hh2o %>%
group_by(reward) %>%
summarize(mean_latency = mean(latency)) %>%
mutate(session = "Overall")
latency_2 <- hsms_hh2o %>%
group_by(reward, session) %>%
summarize(mean_latency = mean(latency), .groups = "drop_last")
latency_summary <- rbind(latency_1, latency_2)
temp <- rbind(hsms_hh2o, hsms_hh2o %>% mutate(session = "Overall")) %>%
mutate(
session = factor(session, levels = c("Overall", "Session 1", "Session 2")))
ggplot(temp, aes(x = latency, fill = reward, color = reward)) +
geom_histogram(position = "identity", bins = 20, alpha = 0.3) +
geom_vline(
data = latency_summary,
aes(xintercept = mean_latency, color = reward),
linetype = "dashed") +
theme(
panel.border = element_blank(),
panel.grid.minor = element_blank(),
axis.text.y = element_blank()) +
facet_grid(rows = vars(session), scales = "free_y") +
scale_fill_manual(values = c(water, strawberry)) +
scale_color_manual(values = c(water, strawberry)) +
labs(
x = "Latency to reward (s)", y = NULL,
fill = "Reward", color = "Reward") +
theme(legend.position = "top")
#| label: tbl-latency
#| tbl-cap: "Mean reward latencies (s) for all trials and separated by session."
latency_summary %>%
pivot_wider(names_from = reward, values_from = mean_latency) %>%
rename(Session = session) %>%
mutate(Difference = Shake - Water) %>%
gt() %>%
fmt_number(columns = -Session, decimals = 2) %>%
tab_options(
table.font.size = px(14)
)
latency_session_id <- hsms_hh2o %>%
group_by(reward, session, id) %>%
summarize(mean_latency = mean(latency), .groups = "drop_last")
ggplot(hsms_hh2o, aes(x = latency, fill = reward, color = reward)) +
geom_histogram(position = "identity", bins = 20, alpha = 0.3) +
geom_vline(
data = latency_session_id,
aes(xintercept = mean_latency, color = reward),
linetype = "dashed") +
theme(
panel.border = element_blank(),
panel.grid.minor = element_blank(),
axis.text.y = element_blank()) +
facet_grid(session~id, scales = "fixed") +
scale_fill_manual(values = c(water, strawberry)) +
scale_color_manual(values = c(water, strawberry)) +
labs(
x = "Latency to reward (s)",
fill = "Reward",
y = NULL,
color = "Reward")
