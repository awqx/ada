select(-n_na) %>%
mutate(region = factor(region, levels = region_levels)) %>%
mutate(
onset = onset * 10,
min_onset = min_onset * 10,
max_onset = max_onset * 10) %>%
group_by(region) %>%
gt() %>%
tab_options(table.font.size = 11) %>%
fmt_number(columns = prop_total, n_sigfig = 3) %>%
data_color(
columns = onset,
method = "numeric",
domain = 0:150,
palette = c("white", "#1a9850"),
na_color = "gray60") %>%
data_color(
