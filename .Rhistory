rename(Train = trn_var_prop, Test = tst_rsq) %>%
pivot_longer(
Train:Test,
names_to = "data_split",
values_to = "var_prop") %>%
mutate(age = factor(age))
# can switch to tst_rsq_prop to visualize better
p <- ggplot(temp) +
facet_grid(region ~ s_order) +
geom_hline(yintercept = 0) +
labs(y = "Proportion of variance explained", color = "Split") +
geom_text(
data = pca_label,
size = 2.5,
hjust = -0.1,
vjust = 1,
mapping = aes(x = -Inf, y = Inf, label = label)) +
theme(
legend.position = "bottom",
strip.text.x = element_blank(),
panel.grid = element_blank()) +
scale_y_continuous(breaks = 0.25 * 0:4)
if (!use_linetype) {
p + geom_line(aes(
x = {{ x_pcs }},
y = var_prop,
color = data_split)) +
scale_x_continuous(breaks = seq(0.0, 1.0, by = 0.2))
} else {
p + geom_line(aes(
x = {{ x_pcs }},
y = var_prop,
linetype = {{ var_linetype }},
color = data_split)) +
scale_x_continuous(breaks = 32 * 0:3)
}
}
pca_stages %>%
filter(sites == "resp") %>%
left_join(s_order, by = c("region", "age")) %>%
ggplot() +
geom_line(aes(x = scaled_pcs, y = tst_rsq, color = stage, linetype = data_type)) +
facet_grid(rows = vars(region), cols = vars(s_order)) +
geom_hline(yintercept = 0) +
scale_color_discrete(palette = palette.colors()[2:3]) +
scale_x_continuous(breaks = seq(0.0, 1.0, by = 0.2)) +
geom_text(
data = all_label,
size = 2.5,
hjust = -0.1,
vjust = 1,
mapping = aes(x = -Inf, y = Inf, label = label)) +
theme(
legend.position = "top",
# axis.text = element_blank(),
strip.text.x = element_blank(),
panel.grid = element_blank()) +
labs(
color = "Stage",
linetype = "Stim.",
x = "Proportion of PCs",
y = "Proportion of variance explained")
#| label: fig-pca
#| fig-cap: Comparisons between the variance explained by the principal components for the training and test set, organized by region (rows) and by session (columns). For responsive sites (top), the x-axis is rescaled for each subplot, and the true number of PCs is in parentheses. For all sites (bottom), the x-axis scale is consistent, but truncated to 96 sites.
#| fig-width: 5.5
#| fig-height: 8
library(patchwork)
source(here("R", "str_info.R"))
pca_types <- c("nonblank", "noisy", "natur")
resp <- lapply(
pca_types,
function(x) {
read.csv(file.path(res_dir, paste0(x, "_resp.csv"))) %>%
mutate(data_type = x)}) %>%
do.call(rbind, .) %>%
mutate(data_type = recode(
data_type,
natur = "Natur.",
noisy = "Noisy",
nonblank = "Non-blank"))
resp_label <- resp %>%
select(region, age, n_pcs) %>%
group_by(region, age) %>%
summarize(n_pcs = max(n_pcs), .groups = "drop_last") %>%
mutate(s_order = row_number()) %>%
mutate(label = paste0(age, " w (", n_pcs, " PCs)"))
p_resp <- plot_pca(resp, resp_label, use_linetype = T) +
labs(
linetype = "Stim.",
x = "Proportion of PCs",
title = "Responsive sites only")
all_sites <- lapply(
pca_types,
function(x) {
read.csv(file.path(res_dir, paste0(x, "_all_sites.csv"))) %>%
mutate(data_type = x)}) %>%
do.call(rbind, .) %>%
mutate(data_type = recode(
data_type,
natur = "Natur.",
noisy = "Noisy",
nonblank = "Non-blank"))
all_label <- all_sites %>%
select(region, age, n_pcs) %>%
group_by(region, age) %>%
summarize(n_pcs = max(n_pcs), .groups = "drop_last") %>%
mutate(s_order = row_number()) %>%
mutate(label = paste0(age, " w (", n_pcs, " PCs)"))
p_all <- plot_pca(all_sites, all_label, x_pcs = n_pcs, use_linetype = T) +
labs(
x = "Number of PCs (up to 96)",
linetype = "Stim.",
title = "All recorded sites")
p_resp + p_all + plot_layout(ncol = 1)
#| label: fig-pca
#| fig-cap: Comparisons between the variance explained by the principal components for the training and test set, organized by region (rows) and by session (columns). For responsive sites (top), the x-axis is rescaled for each subplot, and the true number of PCs is in parentheses. For all sites (bottom), the x-axis scale is consistent, but truncated to 96 sites.
