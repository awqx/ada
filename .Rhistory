#| fig-height: 2.5
set.seed(202607)
reward_aligned_notail <- here(res_dir, "reward_aligned_notail.csv") %>%
read.csv()
reward_aligned_trials <- reward_aligned_notail %>%
rowwise() %>%
mutate(
row_max = max(c_across(photometry_1:photometry_59)),
row_min = min(c_across(photometry_1:photometry_59)),
.before = photometry_1) %>%
filter(row_max <= 20, row_min >= -10) %>%
group_by(id, reward) %>%
slice_sample(n = 5) %>%
pivot_longer(
cols = starts_with("photometry"),
names_to = "s",
names_prefix = "photometry_",
values_to = "y") %>%
mutate(reward = factor(reward)) %>%
mutate(
s = rescale_s(as.numeric(s), 30, 8),
reward = relevel(reward, "Water")) %>%
group_by(id, id_exp, session, reward, trial) %>%
mutate(group_id = cur_group_id()) %>%
ungroup()
reward_aligned_smooths <- lapply(
unique(reward_aligned_trials$group_id),
function(x) {
temp <- reward_aligned_trials %>%
filter(group_id == x) %>%
.$reward %>%
.[1]
reward_aligned_trials %>%
filter(group_id == x) %>%
select(s, y) %>%
as.matrix() %>%
smooth.spline() %>%
predict() %>%
data.frame() %>%
rename(s = x) %>%
mutate(group_id = x, reward = temp)}) %>%
do.call(rbind, .)
reward_aligned_avgs <- reward_aligned_notail %>%
pivot_longer(
cols = starts_with("photometry"),
names_to = "s",
names_prefix = "photometry_",
values_to = "y") %>%
group_by(reward, s) %>%
summarise(y = mean(y), .groups = "drop_last") %>%
ungroup() %>%
mutate(reward = factor(reward)) %>%
mutate(
s = rescale_s(as.numeric(s), 30, 8),
reward = relevel(reward, "Water"))
p_trials <- ggplot() +
geom_line(
data = reward_aligned_smooths,
aes(x = s, y = y, color = reward, group = group_id),
alpha = 0.2) +
geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.5) +
geom_hline(yintercept = 0, linetype = "dashed", alpha = 0.5) +
geom_line(
data = reward_aligned_avgs,
aes(x = s, y = y, color = reward),
linewidth = 1) +
# facet_grid(cols = vars(reward), scales = "fixed") +
scale_color_manual(values = c(water, strawberry)) +
labs(
x = "Time to reward delivery (s)",
# y = "Photometry signal",
y = NULL,
# color = "Reward",
color = NULL) +
theme(
panel.grid = element_blank(),
axis.text.y = element_blank(),
axis.title = element_text(size = 8),
# legend.position = "bottom"
legend.position = c(0.3, 0.8))
p_trials
