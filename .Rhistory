summarize(
trn_pcs = sum(trn_pcs),
tst_pcs = sum(tst_pcs),
n_pcs = max(n_pcs)) %>%
mutate(
region = id_info(id)$region,
age = id_info(id)$age,
data_src = f,
.before = id) %>%
select(-id) }) %>%
do.call(rbind, .) %>%
pivot_wider(
