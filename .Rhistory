library(tibble)
monkey_ <- function(id, region, array, age) {
tibble::as_tibble_row(c(
id = id,
region = region,
array = array,
age = age))
}
monkey_info <- list(
monkey_("M1", "V1", 1, 29),
monkey_("M6", "V1", 2, 36),
monkey_("M1", "V2", 1, 29),
monkey_("M2", "V2", 2, 29),
monkey_("M1", "V4", 1, 29),
monkey_("M2", "V4", 2, 29),
monkey_("M8", "V4", 3, 409),
monkey_("M3", "IT", 1, 20),
monkey_("M6", "IT", 2, 34),
monkey_("M7", "IT", 3, 20),
monkey_("M6", "IT", 4, 221)) %>%
do.call(rbind, .) %>%
mutate(array = as.factor(array))
#| label: fig-monkey
#| fig-width: 6
#| fig-height: 4.5
#| fig-cap: "Labeling by monkey rather than array."
