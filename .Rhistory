resp <- lapply(
pca_types,
function(x) {
read.csv(file.path(res_dir, paste0(x, "_resp.csv"))) %>%
mutate(data_type = x)}) %>%
do.call(rbind, .) %>%
mutate(data_type = recode(
data_type,
natur = "Natur.",
noisy = "Noisy",
nonblank = "Non-blank")) %>%
mutate(data_type = factor(data_type)) %>%
mutate(data_type = relevel(data_type, ref = "Non-blank"))
#| label: tbl-pca
#| tbl-cap: Number of PCs to explain 90% of the variance (scaled to proportion for test set). Non-blank (NB), noisy (Ns), naturalistic (Nt).
thresh <- 0.9
pca_types <- c("nonblank", "noisy", "natur")
pcs_threshold <- lapply(
pca_types,
function(f) {
read.csv(file.path(res_dir, paste0(f, "_resp.csv"))) %>%
group_by(id) %>%
mutate(
trn_pcs = trn_var_prop > thresh,
tst_pcs = tst_rsq_prop > thresh) %>%
summarize(
trn_pcs = sum(trn_pcs),
tst_pcs = sum(tst_pcs),
n_pcs = max(n_pcs)) %>%
mutate(
region = id_info(id)$region,
age = id_info(id)$age,
data_src = f,
.before = id) %>%
select(-id) }) %>%
do.call(rbind, .) %>%
pivot_wider(
names_from = data_src,
values_from = c("trn_pcs", "tst_pcs"))
pcs_threshold %>%
group_by(region) %>%
gt() %>%
tab_options(table.font.size = 12) %>%
tab_spanner(
label = "Train",
columns = vars(trn_pcs_nonblank, trn_pcs_natur, trn_pcs_noisy)) %>%
tab_spanner(
label = "Test",
columns = vars(tst_pcs_nonblank, tst_pcs_natur, tst_pcs_noisy)) %>%
cols_label(
age = "Age (weeks)",
trn_pcs_nonblank = "NB",
tst_pcs_nonblank = "NB",
trn_pcs_noisy = "Ns",
tst_pcs_noisy = "Ns",
trn_pcs_natur = "Nt",
tst_pcs_natur = "Nt",
n_pcs = "Total PCs")
#| label: tbl-pca
#| tbl-cap: Number of PCs to explain 90% of the variance (scaled to proportion for test set). Non-blank (NB), noisy (Ns), naturalistic (Nt).
library(gt)
